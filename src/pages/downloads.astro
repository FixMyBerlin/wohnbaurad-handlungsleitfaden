---
import Download from '@components/mdx/Download.astro'
import PageLayout from '@layouts/PageLayout.astro'
import { getCollection } from 'astro:content'

const downloads = (await getCollection('downloads')).toSorted((a, b) => {
  if (a.id === 'complete-guide') return -1
  if (b.id === 'complete-guide') return 1
  return a.data.title.localeCompare(b.data.title, 'de')
})
---

<PageLayout title="Downloads">
  <h1 slot="header" class="mb-8 text-3xl font-bold">Downloads</h1>
  {downloads.map((download) => <Download id={download.id} />)}
</PageLayout>
