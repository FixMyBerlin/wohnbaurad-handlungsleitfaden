---
import PageHeader from '@components/layout/PageHeader.astro'
import PageLayout from '@layouts/PageLayout.astro'
import { getCollection } from 'astro:content'

const terms = (await getCollection('glossary')).toSorted((a, b) =>
  a.data.term.localeCompare(b.data.term, 'de'),
)
---

<PageLayout title="Glossar">
  <PageHeader slot="header" title="Glossar" />
  <dl>
    {
      terms.map((term) => (
        <>
          <dt id={`begriff-${term.id}`}>{term.data.term}</dt>
          <dd>{term.data.definition}</dd>
        </>
      ))
    }
  </dl>
</PageLayout>
