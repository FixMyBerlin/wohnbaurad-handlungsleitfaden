---
import { mdxComponents } from '@components/mdx'
import BaseLayout from '@layouts/BaseLayout.astro'
import { getEntry, render } from 'astro:content'

const home = await getEntry('startseite', 'index')
if (!home) throw new Error('Missing src/content/startseite/index.mdx')
const { Content } = await render(home)
---

<BaseLayout title={home.data.title} description={home.data.summary}>
  <main id="inhalt" class="mx-auto max-w-5xl px-4 py-12">
    <p class="text-sm font-semibold uppercase">{home.data.eyebrow}</p>
    <h1 class="mt-2 text-4xl font-bold">{home.data.title}</h1>
    <p class="mt-4 text-xl">{home.data.summary}</p>
    <div class="prose mt-10 max-w-none">
      <Content components={mdxComponents} />
    </div>
  </main>
</BaseLayout>
