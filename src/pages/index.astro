---
import SourceList from '@components/layout/SourceList.astro'
import { mdxComponents } from '@components/mdx'
import BaseLayout from '@layouts/BaseLayout.astro'
import { getEntry, render } from 'astro:content'
import { getCitationIds } from 'src/lib/citations'

const home = await getEntry('home', 'index')
if (!home) throw new Error('Missing src/content/home/index.mdx')
const { Content } = await render(home)
const citationIds = await getCitationIds(home.body, home.id)
Astro.locals.citationIds = citationIds
---

<BaseLayout title={home.data.title} description={home.data.summary}>
  <main id="inhalt" class="mx-auto w-full max-w-home px-4 py-12 lg:px-8 lg:py-20">
    <p class="text-sm font-semibold text-petrol-900">{home.data.eyebrow}</p>
    <h1 class="mt-3 text-4xl leading-tight font-bold tracking-tight text-ink sm:text-5xl sm:leading-[52px]">
      {home.data.title}
    </h1>
    <p class="mt-6 max-w-prose text-xl leading-8 text-ink-soft">{home.data.summary}</p>
    <div class="prose prose-lg prose-wbr mt-12 max-w-none">
      <Content components={mdxComponents} />
    </div>
    <SourceList ids={citationIds} />
  </main>
</BaseLayout>
