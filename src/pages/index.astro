---
import PageHeader from '@components/layout/PageHeader.astro'
import SourceList from '@components/layout/SourceList.astro'
import { mdxComponents } from '@components/mdx'
import PageLayout from '@layouts/PageLayout.astro'
import { getEntry, render } from 'astro:content'
import { getCitationIds } from 'src/lib/citations'

const home = await getEntry('home', 'index')
if (!home) throw new Error('Missing src/content/home/index.mdx')
const { Content } = await render(home)
const citationIds = await getCitationIds(home.body, home.id)
Astro.locals.citationIds = citationIds
---

<PageLayout title={home.data.title} description={home.data.summary} toc={false}>
  <PageHeader
    slot="header"
    eyebrow={home.data.eyebrow}
    title={home.data.title}
    summary={home.data.summary}
    size="display"
  />
  <Content components={mdxComponents} />
  <SourceList slot="footer" ids={citationIds} />
</PageLayout>
