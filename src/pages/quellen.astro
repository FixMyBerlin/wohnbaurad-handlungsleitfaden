---
import PageHeader from '@components/layout/PageHeader.astro'
import PageLayout from '@layouts/PageLayout.astro'
import { getCollection } from 'astro:content'
import { formatSource } from 'src/lib/sources'

const sources = (await getCollection('sources')).toSorted((a, b) =>
  a.data.title.localeCompare(b.data.title, 'de'),
)
---

<PageLayout title="Quellen & Literatur">
  <PageHeader slot="header" title="Quellen & Literatur" />
  <ul>
    {
      sources.map((source) => (
        <li id={`quelle-${source.id}`}>
          {formatSource(source)}
          {source.data.url && (
            <>
              {' '}
              <a href={source.data.url}>Link</a>
            </>
          )}
        </li>
      ))
    }
  </ul>
</PageLayout>
