---
import PageHeader from '@components/layout/PageHeader.astro'
import PrevNext from '@components/layout/PrevNext.astro'
import SourceList from '@components/layout/SourceList.astro'
import { mdxComponents } from '@components/mdx'
import PageLayout from '@layouts/PageLayout.astro'
import { getCollection, getEntry, render } from 'astro:content'
import { getCitationIds } from 'src/lib/citations'
import { getChapterTree, getPrevNext } from 'src/lib/navigation'

export const getStaticPaths = async () => {
  const pages = await getCollection('seiten')
  return pages.map((page) => {
    const [kapitel, seite] = page.id.split('/')
    return { params: { kapitel, seite }, props: { page } }
  })
}

const { page } = Astro.props
const chapter = await getEntry(page.data.kapitel)
const { Content, headings } = await render(page)
const { prev, next } = getPrevNext(await getChapterTree(), page.id)
const citationIds = await getCitationIds(page.body, page.id)
Astro.locals.citationIds = citationIds
---

<PageLayout title={page.data.title} description={page.data.summary} headings={headings}>
  <PageHeader slot="header" page={page} chapter={chapter} />
  <Content components={mdxComponents} />
  <Fragment slot="footer">
    <SourceList ids={citationIds} />
    <PrevNext prev={prev} next={next} />
  </Fragment>
</PageLayout>
