---
import Footer from '@components/layout/Footer.astro'
import Header from '@components/layout/Header.astro'
import { ASTRO_ENV } from 'astro:env/client'
import 'src/styles/global.css'

type Props = {
  title: string
  description?: string
}

const { title, description } = Astro.props
const siteTitle = 'Handlungsleitfaden WohnBauRad'
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === siteTitle ? title : `${title} – ${siteTitle}`}</title>
    {description && <meta name="description" content={description} />}
    {/* Netlify previews must never be indexed; the X-Robots-Tag in netlify.toml is the first guard */}
    {ASTRO_ENV !== 'production' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex min-h-screen flex-col bg-surface font-sans text-ink antialiased">
    <a href="#inhalt" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2">Zum Inhalt springen</a>
    <Header />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
