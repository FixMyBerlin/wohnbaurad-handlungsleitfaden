---
type Props = {
  example: string
}

// Interactive map with opt-in follows in phase 5 (react-map-gl, see docs/concept/technical-plan.md E8)
const { example } = Astro.props
---

<figure class="not-prose my-6 border border-dashed border-gray-400 p-8 text-center">
  <figcaption>Karte mit Beispielflächen „{example}“</figcaption>
</figure>
