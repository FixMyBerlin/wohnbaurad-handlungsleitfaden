---
import placeholderMap from '@assets/maps/placeholder-area.webp'
import { Image } from 'astro:assets'

type Props = {
  example: string
}

// Static image until the interactive map with opt-in follows in phase 5 (react-map-gl, technical-plan E8)
const { example } = Astro.props
---

<figure class="not-prose my-12 max-w-[var(--container-main)]" data-example={example}>
  <Image
    src={placeholderMap}
    alt="PLATZHALTER: Karte mit Beispielflächen, Screenshot aus dem Flächen-Finder"
    class="block h-auto w-full border border-violet-800"
  />
  <figcaption class="mt-3 flex flex-col gap-2">
    <div class="border border-dashed border-violet-800 px-4 py-3.5">PLATZHALTER: Legende aus dem Flächen-Finder</div>
    <span class="font-mono text-sm leading-[22px]">Beispielflächen: PLATZHALTER · Kartengrundlage: PLATZHALTER</span>
  </figcaption>
</figure>
