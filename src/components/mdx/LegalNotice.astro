---
type Props = {
  variant?: 'page' | 'templates'
  reviewedBy?: string
  reviewedAt?: string
}

const { variant = 'page', reviewedBy, reviewedAt } = Astro.props
const text =
  variant === 'templates'
    ? 'Die Vorlagen sind Muster und ersetzen keine Rechtsberatung. Passen Sie sie an Ihren Fall und Ihr Landesrecht an.'
    : 'Diese Seite gibt einen Überblick und ersetzt keine Rechtsberatung. Landesrecht kann abweichen.'
const reviewed = reviewedAt
  ? new Date(reviewedAt).toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric' })
  : undefined
---

<aside role="note" class="on-violet not-prose my-12 max-w-reading bg-violet-800 p-6 text-white">
  <p class="mb-2 font-label text-xl leading-7 font-bold">Rechtlicher Hinweis</p>
  <p>{text}</p>
  {
    reviewedBy && (
      <p class="mt-2 font-mono text-sm leading-[22px]">
        Geprüft durch {reviewedBy}
        {reviewed && <> · Stand {reviewed}</>}
      </p>
    )
  }
</aside>
