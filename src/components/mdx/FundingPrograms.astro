---
import { getCollection } from 'astro:content'
import { isExample } from 'src/lib/examples'
import FundingProgram from './FundingProgram.astro'

type Props = {
  level?: 'federal' | 'state' | 'eu'
}

const { level } = Astro.props
const programs = (
  await getCollection('fundingPrograms', (program) => !isExample(program.id) && (!level || program.data.level === level))
).toSorted((a, b) => a.data.name.localeCompare(b.data.name, 'de'))
---

{programs.map((program) => <FundingProgram id={program.id} />)}
