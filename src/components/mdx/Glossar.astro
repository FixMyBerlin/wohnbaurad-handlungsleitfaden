---
import { getEntry } from 'astro:content'

type Props = {
  term: string
}

const entry = await getEntry('glossar', Astro.props.term)
if (!entry) throw new Error(`<Glossar term="${Astro.props.term}"> not found in src/content/glossar.yaml`)
const hasText = Astro.slots.has('default')
---

<a href={`/glossar#begriff-${entry.id}`} title={entry.data.definition} class="underline decoration-dotted">{hasText ? <slot /> : entry.data.begriff}</a>
