---
import { getCollection } from 'astro:content'
import { isExample } from 'src/lib/examples'
import StakeholderCard from './StakeholderCard.astro'

type Props = {
  ids?: string[]
}

const { ids } = Astro.props
const stakeholders = (await getCollection('stakeholders', (entry) => (ids ? ids.includes(entry.id) : !isExample(entry.id))))
  .toSorted((a, b) => a.data.order - b.data.order)
---

<div class="not-prose my-12 grid max-w-[var(--container-main)] grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-6">
  {stakeholders.map((entry) => <StakeholderCard id={entry.id} />)}
</div>
