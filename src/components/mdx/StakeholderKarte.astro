---
type Props = {
  name: string
  typ: string
  interesse: string
  einfluss: 'hoch' | 'mittel' | 'gering'
}

const { name, typ, interesse, einfluss } = Astro.props
---

<article class="border border-gray-300 p-4">
  <h3 class="font-semibold">{name}</h3>
  <p class="text-sm">{typ} · Einfluss: {einfluss}</p>
  <p class="mt-2">Interesse: {interesse}</p>
  {Astro.slots.has('default') && <div class="prose mt-2"><strong>Tipp:</strong> <slot /></div>}
</article>
