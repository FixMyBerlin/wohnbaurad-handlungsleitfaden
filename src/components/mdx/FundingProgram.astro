---
import { getEntry } from 'astro:content'

type Props = {
  id: string
}

const program = await getEntry('fundingPrograms', Astro.props.id)
if (!program) throw new Error(`<FundingProgram id="${Astro.props.id}"> not found in src/content/funding-programs/`)
const { data } = program
const levelLabels = { federal: 'Bund', state: 'Land', eu: 'EU' } as const
const updatedAt = data.updatedAt.toLocaleDateString('de-DE', { month: '2-digit', year: 'numeric' })
---

<article class="not-prose my-6 border border-gray-300 p-4">
  <h3 class="font-semibold">{data.name}</h3>
  <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
    <dt>Geber</dt><dd>{data.funder}</dd>
    <dt>Ebene</dt><dd>{levelLabels[data.level]}{data.state && <> ({data.state})</>}</dd>
    <dt>Gefördert wird</dt><dd>{data.scope}</dd>
    <dt>Antragsberechtigt</dt><dd>{data.eligibility}</dd>
    {data.fundingRate && <><dt>Förderquote</dt><dd>{data.fundingRate}</dd></>}
    {data.deadline && <><dt>Frist</dt><dd>{data.deadline}</dd></>}
    <dt>Stand</dt><dd>{updatedAt}</dd>
  </dl>
  <a href={data.url} class="mt-2 inline-block underline">Zum Programm</a>
</article>
