---
import { getCollection } from 'astro:content'
import Foerderprogramm from './Foerderprogramm.astro'

type Props = {
  ebene?: 'bund' | 'land' | 'eu'
}

const { ebene } = Astro.props
const programs = (
  await getCollection('foerderprogramme', (program) => !ebene || program.data.ebene === ebene)
).toSorted((a, b) => a.data.name.localeCompare(b.data.name, 'de'))
---

{programs.map((program) => <Foerderprogramm id={program.id} />)}
