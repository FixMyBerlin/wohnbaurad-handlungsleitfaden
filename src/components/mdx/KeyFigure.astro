---
import Cite from './Cite.astro'

type Props = {
  value: string
  source: string
}

const { value, source } = Astro.props
---

<div class="flex flex-col justify-between gap-[26px] bg-lime-300 p-4 tabular-nums">
  <div>
    <p class="font-display text-[40px] leading-[52px] font-bold lg:text-5xl lg:leading-[66px]">{value}</p>
    <p class="mt-2.5 text-xl leading-[26px]"><slot /></p>
  </div>
  <p class="font-mono text-sm leading-[22px]">Quelle <Cite id={source} /></p>
</div>
