---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

type Props = {
  step: number
  // Path below `src/assets/`, e.g. `screenshots/flaechenfinder-suche.png`
  image: string
  alt: string
}

const { step, image, alt } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{png,jpg,jpeg,webp}')
const loader = images[`/src/assets/${image}`]
if (!loader) throw new Error(`<ScreenshotSchritt image="${image}"> not found below src/assets/`)
const { default: src } = await loader()
---

<figure class="my-6">
  <p class="font-semibold">Schritt {step}</p>
  <Image src={src} alt={alt} />
  <figcaption><slot /></figcaption>
</figure>
