---
import { getCollection } from 'astro:content'
import { isExample } from 'src/lib/examples'

type Props = {
  topic?: string
  ids?: string[]
}

const { topic, ids } = Astro.props
const entries = (
  await getCollection(
    'sources',
    (source) =>
      source.data.type === 'literature' &&
      (!topic || source.data.topics.includes(topic)) &&
      (ids ? ids.includes(source.id) : !isExample(source.id)),
  )
).toSorted((a, b) => b.data.year - a.data.year)
---

<ul class="not-prose my-6 max-w-reading border-t border-violet-800">
  {
    entries.map((source) => (
      <li class="border-b border-violet-800 py-3.5">
        <p class="font-mono text-sm leading-[22px]">
          {[source.data.year, source.data.publisher ?? source.data.author].filter(Boolean).join(' · ')}
        </p>
        <p class="mt-1 font-bold">
          {source.data.url ? <a href={source.data.url}>{source.data.title}</a> : source.data.title}
        </p>
        {source.data.summary && <p class="mt-1">{source.data.summary}</p>}
      </li>
    ))
  }
</ul>
