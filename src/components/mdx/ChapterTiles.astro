---
import { getCollection } from 'astro:content'
import { chapterPath } from 'src/lib/navigation'

const chapters = (await getCollection('chapters')).toSorted((a, b) => a.data.order - b.data.order)

// Outline icons in the style of Heroicons; the design session may replace them
const icons = {
  map: ['M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z', 'M9 4v14M15 6v14'],
  bike: ['M5.5 17.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z', 'M18.5 17.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z', 'M5.5 14 9 7h5l4.5 7', 'M9 7l3 7h-6.5', 'M14 5h2'],
  people: ['M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', 'M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6', 'M17 11.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z', 'M16 14.2c2.9.4 5 2.8 5 5.8'],
  scale: ['M12 4v16', 'M7 20h10', 'M4 8h16', 'M6 8l-3 6a3 3 0 0 0 6 0L6 8Z', 'M18 8l-3 6a3 3 0 0 0 6 0l-3-6Z'],
  coins: ['M9 9c3.3 0 6-1.1 6-2.5S12.3 4 9 4 3 5.1 3 6.5 5.7 9 9 9Z', 'M3 6.5v4C3 11.9 5.7 13 9 13s6-1.1 6-2.5v-4', 'M3 10.5v4C3 15.9 5.7 17 9 17c1 0 1.9-.1 2.7-.3', 'M15 20c3.3 0 6-1.1 6-2.5S18.3 15 15 15s-6 1.1-6 2.5 2.7 2.5 6 2.5Z'],
  home: ['M4 20V9l8-5 8 5v11', 'M9 20v-6h6v6', 'M4 20h16'],
} as const
---

<ol class="not-prose my-10 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
  {
    chapters.map((chapter) => (
      <li class="flex flex-col overflow-hidden rounded-lg border border-border">
        <div class="flex items-center justify-between bg-petrol-50 p-5">
          <span class="text-[13px] font-semibold text-petrol-900">
            {chapter.data.number ? `Kapitel ${chapter.data.number}` : ''}
          </span>
          {chapter.data.icon && (
            <svg
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-petrol-900"
              aria-hidden="true"
            >
              {icons[chapter.data.icon].map((d) => (
                <path d={d} />
              ))}
            </svg>
          )}
        </div>
        <div class="flex flex-col gap-2 p-5">
          <h3 class="text-xl font-semibold">
            <a href={chapterPath(chapter)} class="text-ink no-underline hover:text-petrol-900">
              {chapter.data.title}
            </a>
          </h3>
          {chapter.data.shortText && <p class="text-[15px] leading-[22px] text-ink-soft">{chapter.data.shortText}</p>}
        </div>
      </li>
    ))
  }
</ol>
