---
import { getCollection } from 'astro:content'
import { chapterPath } from 'src/lib/navigation'

const chapters = (await getCollection('chapters')).toSorted((a, b) => a.data.order - b.data.order)

// Outline icons in the style of Heroicons; the design session may replace them
const icons = {
  map: ['M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z', 'M9 4v14M15 6v14'],
  bike: ['M5.5 17.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z', 'M18.5 17.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z', 'M5.5 14 9 7h5l4.5 7', 'M9 7l3 7h-6.5', 'M14 5h2'],
  people: ['M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z', 'M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6', 'M17 11.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z', 'M16 14.2c2.9.4 5 2.8 5 5.8'],
  scale: ['M12 4v16', 'M7 20h10', 'M4 8h16', 'M6 8l-3 6a3 3 0 0 0 6 0L6 8Z', 'M18 8l-3 6a3 3 0 0 0 6 0l-3-6Z'],
  coins: ['M9 9c3.3 0 6-1.1 6-2.5S12.3 4 9 4 3 5.1 3 6.5 5.7 9 9 9Z', 'M3 6.5v4C3 11.9 5.7 13 9 13s6-1.1 6-2.5v-4', 'M3 10.5v4C3 15.9 5.7 17 9 17c1 0 1.9-.1 2.7-.3', 'M15 20c3.3 0 6-1.1 6-2.5S18.3 15 15 15s-6 1.1-6 2.5 2.7 2.5 6 2.5Z'],
  home: ['M4 20V9l8-5 8 5v11', 'M9 20v-6h6v6', 'M4 20h16'],
} as const
---

<ol class="not-prose my-12 grid max-w-[var(--container-main)] list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
  {
    chapters.map((chapter) => (
      <li>
        <a
          href={chapterPath(chapter)}
          class="group flex h-full flex-col border border-violet-800 bg-white text-violet-800 no-underline hover:bg-lime-300 hover:text-violet-800 focus-visible:bg-lime-300"
        >
          <span class="flex items-center justify-between gap-3 bg-violet-800 px-4 py-3 text-white group-hover:bg-violet-950 group-focus-visible:bg-violet-950">
            <span class="caps text-sm leading-[22px]">{chapter.data.number ? `Kapitel ${chapter.data.number}` : ''}</span>
            {chapter.data.icon && (
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {icons[chapter.data.icon].map((d) => (
                  <path d={d} />
                ))}
              </svg>
            )}
          </span>
          <span class="flex flex-col gap-2 p-4">
            <h3 class="font-display text-xl leading-7 font-semibold group-hover:underline group-focus-visible:underline">{chapter.data.title}</h3>
            {chapter.data.shortText && <span>{chapter.data.shortText}</span>}
          </span>
        </a>
      </li>
    ))
  }
</ol>
