---
import { getCollection } from 'astro:content'
import { chapterPath } from 'src/lib/navigation'

const chapters = (await getCollection('chapters')).toSorted((a, b) => a.data.order - b.data.order)

---

<ol class="not-prose my-12 grid max-w-[var(--container-main)] list-none grid-cols-1 gap-6 p-0 md:grid-cols-2 lg:grid-cols-3">
  {
    chapters.map((chapter) => (
      <li>
        <a
          href={chapterPath(chapter)}
          class="group flex h-full flex-col border border-violet-800 bg-white text-violet-800 no-underline hover:bg-lime-300 hover:text-violet-800 focus-visible:bg-lime-300"
        >
          <span class="flex items-center justify-between gap-3 bg-violet-800 px-4 py-3 text-white group-hover:bg-violet-950 group-focus-visible:bg-violet-950">
            <span class="caps text-sm leading-[22px]">{chapter.data.number ? `Kapitel ${chapter.data.number}` : ''}</span>
          </span>
          <span class="flex flex-col gap-2 p-4">
            <h3 class="font-display text-xl leading-7 font-semibold group-hover:underline group-focus-visible:underline">{chapter.data.title}</h3>
            {chapter.data.shortText && <span>{chapter.data.shortText}</span>}
          </span>
        </a>
      </li>
    ))
  }
</ol>
