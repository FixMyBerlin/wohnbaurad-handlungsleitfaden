---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

type Props = {
  step: number
  // Path below `src/assets/`, e.g. `screenshots/area-finder-search.png`
  image: string
  alt: string
}

const { step, image, alt } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{png,jpg,jpeg,webp}')
const loader = images[`/src/assets/${image}`]
if (!loader) throw new Error(`<ScreenshotStep image="${image}"> not found below src/assets/`)
const { default: src } = await loader()
---

<figure class="not-prose my-8 max-w-[var(--container-main)]">
  <figcaption class="flex items-start gap-3">
    <span class="flex size-8 flex-none items-center justify-center bg-violet-800 font-mono text-lime-300" aria-hidden="true">{step}</span>
    <span><strong>Schritt {step}:</strong> <slot /></span>
  </figcaption>
  <Image src={src} alt={alt} class="mt-3 aspect-video w-full border border-violet-800 object-cover" />
</figure>
