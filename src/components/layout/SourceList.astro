---
import { getEntries } from 'astro:content'
import { formatSource } from 'src/lib/sources'

type Props = {
  ids: string[]
}

const sources = await getEntries(Astro.props.ids.map((id) => ({ collection: 'sources', id })))
---

{
  sources.length > 0 && (
    <section aria-labelledby="quellen" class="max-w-reading">
      <h2 id="quellen" class="mt-12 mb-4 font-display text-[28px] leading-9 font-semibold">
        Quellen
      </h2>
      <ol class="list-decimal space-y-2 pl-5">
        {sources.map((source) => (
          <li id={`quelle-${source.id}`}>
            {formatSource(source)}
            {source.data.url && (
              <>
                {' '}
                <a href={source.data.url} class="underline">
                  Link
                </a>
              </>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}
