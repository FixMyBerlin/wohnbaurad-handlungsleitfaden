---
import { getEntries } from 'astro:content'
import { formatSource } from 'src/lib/sources'

type Props = {
  ids: string[]
}

const sources = await getEntries(Astro.props.ids.map((id) => ({ collection: 'sources', id })))
---

{
  sources.length > 0 && (
    <section aria-labelledby="sources-title" class="mt-12 border-t border-gray-200 pt-6 text-sm">
      <h2 id="sources-title" class="font-semibold">
        Quellen
      </h2>
      <ol class="mt-2 list-decimal space-y-1 pl-5">
        {sources.map((source) => (
          <li id={`quelle-${source.id}`}>
            {formatSource(source)}
            {source.data.url && (
              <>
                {' '}
                <a href={source.data.url}>Link</a>
              </>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}
