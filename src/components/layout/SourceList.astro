---
import { getEntries } from 'astro:content'
import { formatSource } from 'src/lib/sources'

type Props = {
  ids: string[]
}

const sources = await getEntries(Astro.props.ids.map((id) => ({ collection: 'sources', id })))
---

{
  sources.length > 0 && (
    <section aria-labelledby="sources-title" class="mt-14 border-t border-border pt-6">
      <h2 id="sources-title" class="text-base font-semibold text-ink">
        Quellen
      </h2>
      <ol class="mt-3 list-decimal space-y-1 pl-6 text-sm leading-[22px] text-ink-soft">
        {sources.map((source) => (
          <li id={`quelle-${source.id}`}>
            {formatSource(source)}
            {source.data.url && (
              <>
                {' '}
                <a href={source.data.url} class="text-petrol-900 underline underline-offset-2">
                  Link
                </a>
              </>
            )}
          </li>
        ))}
      </ol>
    </section>
  )
}
