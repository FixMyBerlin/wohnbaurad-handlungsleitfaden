---
import type { CollectionEntry } from 'astro:content'
import { pagePath } from 'src/lib/navigation'

type Props = {
  prev?: CollectionEntry<'pages'>
  next?: CollectionEntry<'pages'>
}

const { prev, next } = Astro.props
const button =
  'inline-flex min-h-[50px] items-center border border-violet-800 bg-white px-5 font-display font-semibold no-underline hover:bg-cream-50'
---

<nav aria-label="Seitenwechsel" class="mt-12 flex flex-col gap-8 border-t border-violet-800 pt-8 md:flex-row md:justify-between">
  {
    prev ? (
      <div class="flex flex-col items-start gap-3">
        <a href={pagePath(prev)} rel="prev" aria-label={`Zurück: ${prev.data.title}`} class={button}>
          Zurück
        </a>
        <span class="font-display font-bold">{prev.data.title}</span>
      </div>
    ) : (
      <span />
    )
  }
  {
    next && (
      <div class="flex flex-col items-start gap-3 md:items-end md:text-right">
        <a href={pagePath(next)} rel="next" aria-label={`Weiter: ${next.data.title}`} class={button}>
          Weiter
        </a>
        <span class="font-display font-bold">{next.data.title}</span>
      </div>
    )
  }
</nav>
