---
import type { CollectionEntry } from 'astro:content'
import { pagePath } from 'src/lib/navigation'

type Props = {
  prev?: CollectionEntry<'pages'>
  next?: CollectionEntry<'pages'>
}

const { prev, next } = Astro.props
---

<nav aria-label="Vorherige und nächste Seite" class="mt-14 grid gap-4 border-t border-border pt-6 sm:grid-cols-2">
  {
    prev ? (
      <a href={pagePath(prev)} rel="prev" class="group block no-underline">
        <span class="text-sm text-ink-muted">← Zurück</span>
        <span class="block font-semibold text-petrol-900 group-hover:text-petrol-950">{prev.data.title}</span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next && (
      <a href={pagePath(next)} rel="next" class="group block text-right no-underline">
        <span class="text-sm text-ink-muted">Weiter →</span>
        <span class="block font-semibold text-petrol-900 group-hover:text-petrol-950">{next.data.title}</span>
      </a>
    )
  }
</nav>
