---
import { type ChapterWithPages, chapterPath, pagePath } from 'src/lib/navigation'

type Props = {
  tree: ChapterWithPages[]
  currentPath: string
  variant?: 'sidebar' | 'mobile'
}

const { tree, currentPath, variant = 'sidebar' } = Astro.props
const isCurrentChapter = (chapter: ChapterWithPages) =>
  currentPath === chapterPath(chapter) || currentPath.startsWith(`${chapterPath(chapter)}/`)
const mobile = variant === 'mobile'
const linkColor = mobile
  ? 'text-white hover:text-lime-300 hover:underline'
  : 'text-violet-800 hover:underline'
const activeLink = mobile
  ? 'aria-[current=page]:bg-lime-300 aria-[current=page]:text-violet-800'
  : 'aria-[current=page]:bg-lime-300'
---

<nav aria-label="Kapitel" class="text-base leading-6">
  <div class="mb-[18px] pl-6">
    <a
      href="/"
      aria-current={currentPath === '/' ? 'page' : undefined}
      class:list={['-mx-4 block px-4 py-[7px] aria-[current=page]:font-semibold', linkColor, activeLink]}
    >
      Startseite
    </a>
  </div>
  <ol class="flex flex-col gap-[18px]">
    {
      tree.map((chapter) => {
        // Hanging number: title lines and sub pages align right of the chapter number
        const label = (
          <span class="flex">
            <span class="w-6 shrink-0">{chapter.data.number}</span>
            <span class="group-hover/chapter:underline">{chapter.data.title}</span>
          </span>
        )
        const pages = (
          <ol class="mt-3 flex flex-col gap-1.5 pl-6 text-sm leading-[22px]">
            {chapter.pages.map((page) => (
              <li>
                <a
                  href={pagePath(page)}
                  aria-current={currentPath === pagePath(page) ? 'page' : undefined}
                  class:list={['-mx-4 block px-4 py-[3px] aria-[current=page]:font-semibold aria-[current=page]:no-underline', linkColor, activeLink]}
                >
                  {page.data.navTitle ?? page.data.title}
                </a>
              </li>
            ))}
          </ol>
        )
        return (
          <li>
            {mobile ? (
              <details open={isCurrentChapter(chapter)} class="group">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-3 font-display leading-[26px] font-bold">
                  {label}
                  <svg class="mt-1 shrink-0 transition group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </summary>
                <div class="pl-6">
                  <a href={chapterPath(chapter)} aria-current={currentPath === chapterPath(chapter) ? 'page' : undefined} class:list={['-mx-4 mt-3 block px-4 py-[3px] text-sm leading-[22px]', linkColor, activeLink]}>
                    Kapitelübersicht
                  </a>
                </div>
                {pages}
              </details>
            ) : (
              <>
                <a
                  href={chapterPath(chapter)}
                  aria-current={currentPath === chapterPath(chapter) ? 'page' : undefined}
                  class="group/chapter -mx-4 block px-4 font-display leading-[26px] font-bold no-underline aria-[current=page]:bg-lime-300"
                >
                  {label}
                </a>
                {isCurrentChapter(chapter) && pages}
              </>
            )}
          </li>
        )
      })
    }
  </ol>
</nav>
