---
import { type ChapterWithPages, chapterPath, pagePath } from 'src/lib/navigation'

type Props = {
  tree: ChapterWithPages[]
  currentPath: string
}

const { tree, currentPath } = Astro.props
---

<nav aria-label="Kapitel" class="text-sm">
  <ol class="space-y-5">
    {
      tree.map((chapter) => (
        <li>
          <a
            href={chapterPath(chapter)}
            aria-current={currentPath === chapterPath(chapter) ? 'page' : undefined}
            class="block font-semibold text-ink no-underline hover:text-petrol-900 aria-[current=page]:text-petrol-900"
          >
            {chapter.data.number && <>{chapter.data.number} · </>}
            {chapter.data.title}
          </a>
          <ol class="mt-2 space-y-0.5 border-l border-border pl-3">
            {chapter.pages.map((page) => (
              <li>
                <a
                  href={pagePath(page)}
                  aria-current={currentPath === pagePath(page) ? 'page' : undefined}
                  class="-ml-[13px] block border-l-2 border-transparent py-1 pr-2 pl-[19px] text-ink-muted no-underline hover:text-petrol-900 aria-[current=page]:border-petrol-900 aria-[current=page]:font-semibold aria-[current=page]:text-petrol-900"
                >
                  {page.data.navTitle ?? page.data.title}
                </a>
              </li>
            ))}
          </ol>
        </li>
      ))
    }
  </ol>
</nav>
