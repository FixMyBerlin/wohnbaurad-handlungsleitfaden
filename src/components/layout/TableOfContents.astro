---
import type { MarkdownHeading } from 'astro'

type Props = {
  headings: MarkdownHeading[]
  variant?: 'aside' | 'inline'
}

const { headings, variant = 'aside' } = Astro.props
const h2 = headings.filter((heading) => heading.depth === 2)
---

{
  h2.length > 0 && (
    <nav
      aria-label="Auf dieser Seite"
      class:list={[variant === 'inline' && 'mt-7 flex flex-col gap-3 border-y border-violet-800 py-4']}
    >
      <p class:list={['font-label text-lg leading-[26px] font-bold', variant === 'aside' && 'mb-4']}>Auf dieser Seite</p>
      <ul class="flex flex-col gap-3">
        {h2.map((heading) => (
          <li>
            <a href={`#${heading.slug}`} class="hover:underline">{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
