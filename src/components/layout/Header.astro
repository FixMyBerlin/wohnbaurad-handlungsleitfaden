---
import { getEntry } from 'astro:content'

const gesamtfassung = await getEntry('downloads', 'gesamtfassung')
---

<header class="border-b border-gray-200">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="font-bold">WohnBauRad</a>
    {
      gesamtfassung && (
        <a href={gesamtfassung.data.file} class="rounded border border-gray-900 px-3 py-1.5 text-sm">
          Gesamt-PDF
        </a>
      )
    }
  </div>
</header>
