---
import { getEntry } from 'astro:content'
import { getChapterTree } from 'src/lib/navigation'
import ChapterNav from './ChapterNav.astro'

const completeGuide = await getEntry('downloads', 'complete-guide')
const tree = await getChapterTree()
const currentPath = Astro.url.pathname.replace(/\/$/, '')
---

<header class="border-b border-border">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 lg:px-8">
    <a href="/" class="text-xl font-bold tracking-tight text-ink no-underline">
      WohnBau<span class="text-accent-700">Rad</span>
    </a>
    <div class="flex items-center gap-3">
      {
        completeGuide && (
          <a
            href={completeGuide.data.files[0].path}
            class="hidden min-h-11 items-center rounded-md bg-petrol-900 px-4 text-[15px] font-semibold text-surface hover:bg-petrol-950 sm:inline-flex"
          >
            Gesamt-PDF
          </a>
        )
      }
      <button
        type="button"
        data-menu-open
        aria-controls="menu"
        class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-4 text-[15px] font-semibold text-petrol-900 lg:hidden"
      >
        Menü
      </button>
    </div>
  </div>
  <dialog
    id="menu"
    aria-label="Navigation"
    class="m-0 ml-auto h-full max-h-none w-80 max-w-[85vw] bg-surface p-6 backdrop:bg-ink/40 lg:hidden"
  >
    <div class="mb-6 flex justify-end">
      <button type="button" data-menu-close class="min-h-11 rounded-md px-3 text-sm font-semibold text-petrol-900">
        Schließen
      </button>
    </div>
    <ChapterNav tree={tree} currentPath={currentPath} />
  </dialog>
</header>

<script>
  // Native <dialog> keeps focus inside and closes on Esc
  const dialog = document.querySelector<HTMLDialogElement>('#menu')
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => dialog?.showModal())
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog?.close())
</script>
