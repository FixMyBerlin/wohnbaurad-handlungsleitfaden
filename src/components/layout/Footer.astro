---
import foerderlogo from '@assets/logos/foerderlogo.png'
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'

const footerPages = (await getCollection('singlePages', (page) => page.data.footer)).toSorted(
  (a, b) => a.data.title.localeCompare(b.data.title, 'de'),
)
const links = [
  ...footerPages.map((page) => ({ href: `/${page.id}`, label: page.data.title })),
  { href: '/downloads', label: 'Downloads' },
  { href: '/quellen', label: 'Quellen' },
  { href: '/glossar', label: 'Glossar' },
]
// Partner logo files follow; until then labelled placeholders
const partners = ['Münchner Wohnen', 'FixMyCity']
---

<footer class="mt-20 bg-lime-300 p-8 font-display leading-[26px] font-medium">
  <div class="flex flex-col gap-6 lg:flex-row lg:flex-wrap lg:items-center lg:justify-between lg:gap-x-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:gap-8">
      <Image src={foerderlogo} alt="PLATZHALTER: Förderlogo, genaue Ministeriumsbezeichnung prüfen" width={120} class="h-auto w-[120px]" />
      <p class="max-w-[620px]">
        Gefördert im Rahmen des Nationalen Radverkehrsplans.<br />
        PLATZHALTER: Pflichttext BMDV
      </p>
    </div>
    <ul aria-label="Partner" class="flex flex-wrap gap-4">
      {
        partners.map((partner) => (
          <li class="flex h-14 w-[140px] items-center justify-center border border-dashed border-violet-800 px-2 text-center font-mono text-sm">
            PLATZHALTER: {partner}
          </li>
        ))
      }
    </ul>
    <nav aria-label="Fußzeile" class="lg:basis-full">
      <ul class="flex flex-wrap gap-x-4 gap-y-2 leading-6">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="underline">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
