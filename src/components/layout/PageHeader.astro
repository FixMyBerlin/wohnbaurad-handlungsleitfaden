---
import type { CollectionEntry } from 'astro:content'
import { audienceLabels } from 'src/collections/pages'

type Props = {
  page: CollectionEntry<'pages'>
  chapter: CollectionEntry<'chapters'>
}

const { page, chapter } = Astro.props
const audience = page.data.audience.map((key) => audienceLabels[key]).join(', ')
const updatedAt = page.data.updatedAt.toLocaleDateString('de-DE', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
})
---

<header class="mb-10">
  <p class="text-sm font-semibold text-petrol-900">
    {chapter.data.number ? `Kapitel ${chapter.data.number} · ` : ''}{chapter.data.title}
  </p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink lg:text-4xl">{page.data.title}</h1>
  <p class="mt-4 text-xl leading-8 text-ink-soft">{page.data.summary}</p>
  <p class="mt-3 text-sm text-ink-muted">Für: {audience} · Stand: {updatedAt}</p>
</header>
