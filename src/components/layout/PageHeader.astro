---
type Props = {
  eyebrow?: string
  title: string
  summary?: string
  meta?: string
  size?: 'page' | 'display'
}

const { eyebrow, title, summary, meta, size = 'page' } = Astro.props
---

<header>
  {eyebrow && <p class="caps mb-3 text-base leading-[22px]">{eyebrow}</p>}
  <h1
    class:list={[
      'font-display font-semibold',
      size === 'display'
        ? 'text-[32px] leading-10 md:text-[40px] md:leading-[48px] lg:text-5xl lg:leading-[56px]'
        : 'text-[28px] leading-9 md:text-4xl md:leading-[44px]',
    ]}
  >
    {title}
  </h1>
  {summary && <p class="mt-5 max-w-reading text-xl leading-[30px]">{summary}</p>}
  {meta && <p class="mt-3 font-mono text-sm leading-[22px]">{meta}</p>}
</header>
